# Copy to .env.development or .env.production and adjust values.

# API base URL — empty in dev when using Vite proxy; set for production (e.g. https://api.example.com)
VITE_API_BASE_URL=

# Vite dev server proxy target (Spring Boot URL)
VITE_API_PROXY_TARGET=http://localhost:8080

# Optional Vite dev server port
VITE_DEV_PORT=5173
