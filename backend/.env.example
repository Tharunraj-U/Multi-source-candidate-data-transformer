# Local Ollama (desktop app — NOT Docker)
OLLAMA_BASE_URL=http://localhost:11434/v1
# Use a model from `ollama list` — qwen2.5-coder:3b fits low RAM; llama3:latest needs ~8GB+
OLLAMA_MODEL=qwen2.5-coder:3b
OLLAMA_ENABLED=true
OLLAMA_MAX_INPUT_CHARS=6000
OLLAMA_MAX_OUTPUT_TOKENS=2048

RESUME_TEXT_PROVIDER=tika

GITHUB_TOKEN=
DB_PASSWORD=root
